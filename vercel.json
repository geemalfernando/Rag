{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "rag": {
      "root": ".",
      "buildCommand": "pip install uv && uv sync --frozen --no-dev"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "rag"
      }
    }
  ]
}
